  "title": "Canonical Suitability Model (CSM) v1.0 \u2014 recommendations",
  "type": "object",
  "properties": {
    "recommendations": {
      "type": "array",
      "description": "One entry per discrete recommended action. CHK-006 primary payload.",
      "items": {
        "$ref": "#/$defs/Recommendation"
      }
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "description": "Attach to every extracted entity or statement. This is what makes the model auditable: a QA finding must be able to cite where in the document the asserted fact came from.",
      "additionalProperties": false,
      "required": [
        "assertionStatus"
      ],
      "properties": {
        "assertionStatus": {
          "enum": [
            "Stated",
            "Inferred",
            "Derived",
            "Absent"
          ],
          "description": "Stated = explicit in the document. Inferred = the LLM concluded it from narrative prose. Derived = calculated from other extracted values. Absent = the model expected it and could not find it."
        },
        "documentId": {
          "type": "string",
          "description": "Identifier of the source document within the case bundle."
        },
        "documentCategory": {
          "$ref": "#/$defs/DocumentCategory"
        },
        "pageNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sectionHeading": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim supporting text, trimmed. Required whenever assertionStatus is Stated or Inferred."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extractionNote": {
          "type": "string",
          "description": "Why the LLM read the text this way; ambiguity flags."
        }
      }
    },
    "Money": {
      "type": "object",
      "description": "Aligned to Intelliflo Office CurrencyValue.",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "default": "GBP"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "Gross",
            "Net",
            "Unspecified"
          ]
        },
        "asAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "DocumentCategory": {
      "enum": [
        "A_ClientAuthority",
        "B_KnowYourClient",
        "C_MeetingsAndCommunications",
        "D_RiskCapacityAndExperience",
        "E_ExistingPlansAndPortfolios",
        "F_NeedsAnalysis",
        "G_Research",
        "H_SolutionDesign",
        "I_RecommendationsAndAdvice"
      ],
      "description": "Quality-check document taxonomy (Document Categories v1)."
    },
    "Statement": {
      "type": "object",
      "description": "A narrative assertion the report makes that a check must test for presence, specificity and consistency (rationale bullets, risk warnings, disadvantages, explanations).",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "description": "Short normalised label, e.g. \u0027LowerCosts\u0027, \u0027LossOfGuarantee\u0027, \u0027MarketRisk\u0027."
        },
        "isClientSpecific": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "False where the wording is generic boilerplate. Direct input to CHK-006 personalisation and CHK-008 prominence."
        },
        "linkedObjectiveIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "description": "Aligned to Intelliflo Office Recommendation2Document \u002B BaseRecommendation2Proposal. proposalType reuses the IO proposal discriminator so a recommendation can be pushed into Office as a proposal.",
      "additionalProperties": false,
      "required": [
        "recommendationId",
        "summary"
      ],
      "properties": {
        "recommendationId": {
          "type": "string"
        },
        "sequence": {
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "proposalType": {
          "enum": [
            "NewBusinessPensionProposal",
            "NewBusinessInvestmentProposal",
            "NewBusinessAnnuityProposal",
            "NewBusinessPersonalProtectionProposal",
            "NewBusinessMortgageProposal",
            "NewBusinessEquityReleaseProposal",
            "NewBusinessGeneralInsuranceProposal",
            "ExistingBusinessTransferRolloverProposal",
            "ExistingBusinessSwitchProposal",
            "ExistingBusinessRebalanceProposal",
            "ExistingBusinessNewMoneyProposal",
            "ExistingBusinessLumpsumWithdrawalProposal",
            "ExistingBusinessAmendRegularContributionsPremiumsProposal",
            "ExistingBusinessAmendRegularWithdrawalIncomeProposal",
            "ExistingBusinessAmendProductDetailsProposal",
            "ExistingBusinessCloseProductProposal",
            "ExistingBusinessNoActionProposal",
            "ExistingBusinessReviewedProposal",
            "NonProductProposal",
            null
          ]
        },
        "action": {
          "enum": [
            "NewPlan",
            "Transfer",
            "Switch",
            "Consolidate",
            "Retain",
            "Encash",
            "Surrender",
            "Rebalance",
            "IncreaseContribution",
            "DecreaseContribution",
            "StartWithdrawal",
            "AmendWithdrawal",
            "Crystallise",
            "NonProductAction",
            "Other",
            null
          ]
        },
        "ownerClientIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkedObjectiveIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CHK-006 requires each recommendation to tie to a stated objective."
        },
        "sourceArrangementIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Existing arrangements affected."
        },
        "targetPlanId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference into solution.recommendedPlans."
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "rationale": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "description": "Why this is suitable, in client-specific terms."
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "disadvantages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "description": "CHK-008."
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "description": "CHK-008."
        },
        "taxImplications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "alternativesConsidered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "description": "CHK-006 and CHK-009."
        },
        "clientAgreementStatements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "description": "Where the report records that the client understood or agreed."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Alternative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "alternativeType": {
          "enum": [
            "DoNothing",
            "AlternativeProduct",
            "AlternativeProvider",
            "AlternativeWrapper",
            "AlternativeInvestmentStrategy",
            "StakeholderPension",
            "InvestmentPathway",
            "EmployerScheme",
            "InSituSwitch",
            "Other",
            null
          ]
        },
        "wasConsidered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rejectionReasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "comparativeCost": {
          "$ref": "#/$defs/Money"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    }
  }
}
```


