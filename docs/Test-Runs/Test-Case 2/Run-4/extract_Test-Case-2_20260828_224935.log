  "riskWarningsAndDisadvantages": {
    "generalRiskWarnings": [
      {
        "text": "Whenever you invest you have to accept there is a risk to your capital.",
        "topic": "CapitalAtRisk",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            7
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "You should remember that unit prices and the value of your pension fund can fall as well as rise and there is no guarantee you will receive a return of your original capital, especially in the early years or if you choose to take an income from it.",
        "topic": "NoCapitalGuarantee",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            16
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "Past performance is no guarantee of future returns.",
        "topic": "PastPerformanceNotGuarantee",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            17
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      }
    ],
    "productSpecificRisks": [
      {
        "text": "A switch between pension providers does not guarantee a greater pension fund at retirement and there is no guarantee that the new provider\u0027s funds will outperform those of your existing provider.",
        "topic": "SwitchPerformanceRisk",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ1"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            16
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "There is no guarantee the return on the new investment will be greater than that of your existing arrangement for these funds.",
        "topic": "NoPerformanceGuarantee",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ1"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            11
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      }
    ],
    "investmentRisks": [
      {
        "text": "Whilst the transactions are pending, there could be movements within the stock-market; that is to say that the stock-market could rise or fall in value. If the market rises in value between the date of realising your existing funds and the purchase of your new (funds), you could be financially disadvantaged insofar as the cost of buying your new fund could be greater. Conversely, if there is a fall in the market between the date of realising your existing funds and the purchase of your new funds, you could be financially advantaged insofar as the cost of buying your new funds could be lower.",
        "topic": "SwitchTimingRisk",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ1"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            11
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "A portfolio for this risk profile is most likely to contain a diversified mix of assets including equities, bonds, and other asset classes. It targets moderate capital appreciation and is designed to remain within your agreed level of risk whilst providing the potential for steady growth. The portfolio will have moderate volatility and aims to balance growth potential with capital preservation.",
        "topic": "PortfolioVolatility",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ1"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            6
          ],
          "documentCategory": "D_RiskCapacityAndExperience"
        }
      }
    ],
    "materialDisadvantages": [
      {
        "text": "Should you require access to these funds in the future it will usually take 10-15 working days for administration, disinvestment and banking processes to complete.",
        "topic": "AccessDelay",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ3"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            11
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "Both types of bonds allow cumulative withdrawals of up to 5% of the original investment per policy year without an immediate tax charge. However, exceeding this allowance or surrendering the bond can trigger a chargeable event, leading to potentially significant income tax bills, particularly if not carefully managed.",
        "topic": "BondWithdrawalTaxRisk",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            23
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "Bonds are less transparent in terms of underlying fund charges and investment performance and can involve additional setup and ongoing costs compared to ISAs.",
        "topic": "BondCostAndTransparency",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            23
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "Long-term investment in cash is not recommended due to its inability to keep pace with inflation, leading to erosion of real value over time.",
        "topic": "CashInflationRisk",
        "isClientSpecific": true,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            24
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      }
    ],
    "limitations": [
      {
        "text": "All other risks associated with this investment are detailed in the product literature provided to you. You should read this document carefully.",
        "topic": "ProductLiteratureRisks",
        "isClientSpecific": false,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            11
          ],
          "documentCategory": "I_RecommendationsAndAdvice"
        }
      },
      {
        "text": "It is important to understand that the above charts are projections based on certain assumptions, and even a small variance between the assumptions used and actual experience can result in a marked difference in the outcome when compounded over a long period of time. Please also note that the chart does not consider any potential long-term care costs which could occur in later life.",
        "topic": "CashflowProjectionLimitations",
        "isClientSpecific": true,
        "linkedObjectiveIds": [
          "OBJ3"
        ],
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            21
          ],
          "documentCategory": "H_SolutionDesign"
        }
      }
    ],
    "lossScenariosIllustrated": [
      {
        "description": "Stress test with 30% investment loss and elevated inflation in 2028, with no recovery projected.",
        "lossPercentage": 30,
        "provenance": {
          "assertionStatus": "Stated",
          "pageNumbers": [
            19
          ],
          "documentCategory": "H_SolutionDesign",
          "quote": "I completed a stress test combining an immediate market crash with increased inflation levels. This showed that even if your investments sustained a loss of 30% with no recovery in 2028, there would still be no shortfall throughout your projected lifetime."
        }
      }
    ],
