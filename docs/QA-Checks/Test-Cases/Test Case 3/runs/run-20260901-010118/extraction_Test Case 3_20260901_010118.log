      "rationale": [
        {
          "text": "The funds reflect your risk profile both individually and combined. This means that should there be any portfolio drift, the risk being taken remains the same.",
          "topic": "RiskProfileAlignment",
          "isClientSpecific": true,
          "linkedObjectiveIds": [
            "OBJ3"
          ],
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "It provides exposure to a range of asset classes and market sectors resulting in greater diversification and reduced risk.",
          "topic": "Diversification",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "It provides a blend of active and passive investments, which allows for some active management, whilst keeping costs low.",
          "topic": "CostEfficiency",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "You want to keep the investment strategy of your pension fairly simple.",
          "topic": "Simplicity",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Reported",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "The charges are competitive.",
          "topic": "Charges",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "The funds have performed well in comparison with their peers.",
          "topic": "Performance",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "The funds are part of our CIP (Centralised Investment Proposition). This is regularly reviewed by a quarterly investment committee. We also utilise a leading external research team to ensure regular monitoring and oversight of our recommended funds.",
          "topic": "GovernanceAndOversight",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        },
        {
          "text": "We have recommended a multi-asset fund because it provides a professionally managed, diversified investment solution that aligns with your financial goals and risk profile. These funds are risk-profiled solutions, meaning they are specifically designed to remain within your agreed level of risk, ensuring your investments stay aligned with your preferences. These funds combine the growth potential of equities with the potentially uncorrelated returns of other asset classes, such as bonds, property and absolute return. By investing across a range of asset classes, the fund reduces the risk associated with market volatility while offering the potential for steady growth or income, depending on your needs. Managed by experts who regularly adjust the portfolio to maintain suitability, this option offers simplicity, cost-efficiency, and flexibility as your circumstances evolve, making it a balanced and reliable choice for achieving your long-term financial plans.",
          "topic": "MultiAssetFundRationale",
          "isClientSpecific": true,
          "linkedObjectiveIds": [
            "OBJ3",
            "OBJ4",
            "OBJ5"
          ],
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Recommended",
            "documentId": "Suitability report 2026.pdf",
            "documentCategory": "H_SolutionDesign",
            "pageNumbers": [
              15
            ]
          }
        }
      ],
      "provenance": {
        "assertionStatus": "Stated",
        "modality": "Recommended",
        "documentId": "Suitability report 2026.pdf",
        "documentCategory": "H_SolutionDesign",
        "pageNumbers": [
          15
        ],
        "quote": "In addition to your attitude to investment risk and capacity for loss, I have also considered your investment objectives as well as your knowledge and experience, and the length of time you wish to invest for."
      }
