  "title": "Canonical Suitability Model (CSM) v1.0 \u2014 replacementAnalysis",
  "type": "object",
  "properties": {
    "replacementAnalysis": {
      "type": "array",
      "description": "One entry per plan being replaced/switched/transferred. CHK-009 trigger and payload.",
      "items": {
        "$ref": "#/$defs/ReplacementAnalysis"
      }
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "description": "Attach to every extracted entity or statement. This is what makes the model auditable: a QA finding must be able to cite where in the document the asserted fact came from.",
      "additionalProperties": false,
      "required": [
        "assertionStatus"
      ],
      "properties": {
        "assertionStatus": {
          "description": "Stated = explicit in the document. Inferred = the LLM concluded it from narrative prose. Derived = calculated from other extracted values. Absent = the model expected it and could not find it. One of: Stated, Inferred, Derived, Absent.",
          "type": "string"
        },
        "modality": {
          "description": "What KIND of claim this is, which is a different question from assertionStatus and is answered independently of it. assertionStatus says how we came to know the value; modality says what the document is asserting about it. Both a current salary and a retirement income projected thirty years out can be Stated, and comparing them as though they were the same claim is how a projection comes to be reported as a discrepancy against a fact find. Actual = true at the date of the report. Reported = the client said so. Intended = the client plans it. Assumed = an adviser or modelling assumption. Projected = a future value from an illustration or cashflow. Recommended = part of the advice rather than the current position. Conditional = only holds if a stated condition applies, including a charge phrased as \u0022if you were to retain the plan\u0022. Unknown = the document does not make it determinable. Where the report gives no signal, Reported is the usual reading for a client circumstance and Actual for a figure the report states as current fact. One of: Actual, Reported, Intended, Assumed, Projected, Recommended, Conditional, Unknown.",
          "type": "string"
        },
        "documentId": {
          "type": "string",
          "description": "Identifier of the source document within the case bundle."
        },
        "documentCategory": {
          "$ref": "#/$defs/DocumentCategory"
        },
        "pageNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sectionHeading": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim supporting text, trimmed. Required whenever assertionStatus is Stated or Inferred."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extractionNote": {
          "type": "string",
          "description": "Why the LLM read the text this way; ambiguity flags."
        }
      }
    },
    "Money": {
      "type": "object",
      "description": "Aligned to Intelliflo Office CurrencyValue.",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "default": "GBP"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "description": "One of: Gross, Net, Unspecified."
        },
        "asAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Percentage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Percentage points, e.g. 0.44 means 0.44%."
        },
        "basis": {
          "type": "string",
          "description": "What the percentage is of, e.g. \u0027of fund value pa\u0027."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "DocumentCategory": {
      "description": "Quality-check document taxonomy (Document Categories v1). One of: A_ClientAuthority, B_KnowYourClient, C_MeetingsAndCommunications, D_RiskCapacityAndExperience, E_ExistingPlansAndPortfolios, F_NeedsAnalysis, G_Research, H_SolutionDesign, I_RecommendationsAndAdvice.",
      "type": "string"
    },
    "Statement": {
      "type": "object",
      "description": "A narrative assertion the report makes that a check must test for presence, specificity and consistency (rationale bullets, risk warnings, disadvantages, explanations).",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "description": "Short normalised label, e.g. \u0027LowerCosts\u0027, \u0027LossOfGuarantee\u0027, \u0027MarketRisk\u0027."
        },
        "isClientSpecific": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "False where the wording is generic boilerplate. Direct input to CHK-006 personalisation and CHK-008 prominence."
        },
        "linkedObjectiveIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Alternative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "alternativeType": {
          "type": [
            "string",
            "null"
          ],
          "description": "One of: DoNothing, AlternativeProduct, AlternativeProvider, AlternativeWrapper, AlternativeInvestmentStrategy, StakeholderPension, InvestmentPathway, EmployerScheme, InSituSwitch, Other."
        },
        "wasConsidered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rejectionReasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "comparativeCost": {
          "$ref": "#/$defs/Money"
        },
        "quote": {
          "$ref": "#/$defs/AlternativeQuote"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "AlternativeQuote": {
      "type": "object",
      "description": "The figures behind an alternative that was actually quoted rather than merely named \u2014 in practice an annuity quotation, or a comparable-annuity income in a sustainability table. Separate from comparativeCost because that is one amount and this is a claim about a product: an income per annum, on a term basis, from a named provider. Without it a report stating that an annuity would pay a given income asserts a checkable number that no check can reach.",
      "additionalProperties": false,
      "properties": {
        "quotingProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "termBasis": {
          "type": [
            "string",
            "null"
          ],
          "description": "One of: Lifetime, FixedTerm, UntilStatePensionAge, Other."
        },
        "grossAnnualIncome": {
          "$ref": "#/$defs/Money"
        },
        "guaranteedMaturityValue": {
          "$ref": "#/$defs/Money"
        },
        "paymentFrequency": {
          "type": [
            "string",
            "null"
          ],
          "description": "One of: Monthly, Quarterly, HalfYearly, Annually, Other."
        },
        "quotedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "ReplacementAnalysis": {
      "type": "object",
      "description": "One per ceding arrangement. Everything CHK-009 asks for is a named field so absence is detectable rather than inferred from prose.",
      "additionalProperties": false,
      "required": [
        "cedingArrangementId"
      ],
      "properties": {
        "cedingArrangementId": {
          "type": "string"
        },
        "receivingPlanId": {
          "type": [
            "string",
            "null"
          ]
        },
        "replacementType": {
          "type": [
            "string",
            "null"
          ],
          "description": "One of: PensionSwitch, PensionTransferDB, InvestmentReRegistration, BondSurrender, IsaTransfer, Encashment, Other."
        },
        "transferValue": {
          "$ref": "#/$defs/Money"
        },
        "comparison": {
          "type": "array",
          "description": "Existing vs recommended on each dimension.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension": {
                "type": "string",
                "description": "One of: Charges, FundRange, Performance, RiskAlignment, RetirementOptions, Flexibility, AdviserServicing, DeathBenefits, Guarantees, Service, Other."
              },
              "existingPosition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recommendedPosition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessment": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "One of: Better, Worse, Equivalent, NotAssessed."
              },
              "provenance": {
                "$ref": "#/$defs/Provenance"
              }
            }
          }
        },
        "benefitsOfSwitching": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "costsOfSwitching": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exitPenalty": {
              "$ref": "#/$defs/Money"
            },
            "initialAdviceFee": {
              "$ref": "#/$defs/Money"
            },
            "annualChargeDifferencePercentage": {
              "$ref": "#/$defs/Percentage"
            },
            "annualChargeDifferenceAmount": {
              "$ref": "#/$defs/Money"
            },
            "outOfMarketExposure": {
              "type": [
                "string",
                "null"
              ]
            },
            "provenance": {
              "$ref": "#/$defs/Provenance"
            }
          },
          "description": "The stated cost comparison, with its basis: like-for-like, including adviser fees, or per scheme. Component comparisons (platform only, funds only) are separate from total-cost ones \u2014 record which the basis covers. Preserve sign and direction exactly: a new plan dearer once fees are included is a materially different claim from a like-for-like saving, and they routinely appear in the same report."
        },
        "featuresOrGuaranteesLost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "featuresGained": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "employerContributionsLost": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "alternativesConsidered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Alternative"
          }
        },
        "netBenefitConclusion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    }
  }
}
```


