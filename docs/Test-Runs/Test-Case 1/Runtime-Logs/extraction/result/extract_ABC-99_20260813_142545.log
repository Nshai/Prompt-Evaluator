      "allowsAdviserChargeFacilitation": false,
      "isLifestyling": false,
      "adviceAction": "Encash",
      "adviceActionRationale": [
        {
          "text": "The funds do not meet your risk profile; Currently, Scottish Widows does not offer a single multi-asset fund that aligns with your risk rating of 5. To achieve this level of risk, we would need to combine two funds. One of which is entirely invested in money market (cash) holdings. This would effectively leave around 20-30% of your portfolio out of the market.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              6
            ]
          }
        },
        {
          "text": "We want to ensure that your entire investment is working for you, so we want to find a solution that keeps 100% of your funds invested in the market.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              6
            ]
          }
        },
        {
          "text": "Scottish Widows does not allow adviser management, which you would like to benefit from to ensure you are on the right track for retirement.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              6
            ]
          }
        },
        {
          "text": "We would recommend you withdraw the full amount of this pension under the small pots rules and put the money into your savings account. This would not detract from your financial retirement plan. Under the small pot rules, a \u00A3200 pension fund withdrawal would be taxed with 25% taken as tax-free cash and the remaining 75% taxed as income at your marginal tax rate. We estimate you would receive \u00A3170 net.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              6
            ]
          }
        }
      ],
      "provenance": {
        "assertionStatus": "Stated",
        "pageNumbers": [
          5,
          6
        ],
        "documentCategory": "E_ExistingPlansAndPortfolios"
      }
