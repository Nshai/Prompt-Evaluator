      ],
      "adviceAction": "FullTransfer",
      "adviceActionRationale": [
        {
          "text": "Your funds are currently invested in lifestyling funds, which automatically reduce investment risk as you approach retirement. As a result, your portfolio will eventually move outside of your agreed risk range. We would not recommend remaining invested in these types of funds.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              7
            ]
          }
        },
        {
          "text": "The receiving scheme has a lower overall cost structure compared to your existing pension, meaning more of your savings remain invested for growth rather than being lost to charges.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              7
            ]
          }
        },
        {
          "text": "The new scheme offers access to a wider range of investment options, allowing for a more tailored investment strategy that better suits your risk profile and retirement goals, and allowing greater choice should your risk profile change in the future.",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              7
            ]
          }
        },
        {
          "text": "The new scheme allows adviser charges to be deducted directly, ensuring ongoing financial planning support without the need for separate payments. This makes it easier to manage your retirement strategy effectively.",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              7
            ]
          }
        },
        {
          "text": "By moving to the recommended scheme, I will have the ability to actively monitor and adjust your investments as required, helping to ensure they remain aligned with your changing needs and market conditions.",
          "isClientSpecific": false,
          "provenance": {
            "assertionStatus": "Stated",
            "pageNumbers": [
              7
            ]
          }
        }
