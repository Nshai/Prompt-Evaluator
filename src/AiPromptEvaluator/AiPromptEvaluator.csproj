<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop front end: forms, their designers, and the entry point.
    Everything it drives lives in AiPromptEvaluator.Core, which knows nothing about WinForms.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    The container implementation, which only the composition root needs. Core declares what it
    registers against the abstractions; this project is where a provider is built.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!--
    The schema and query plans travel with Core, which carries them into this project's output
    as well. Nothing here needs to name them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AiPromptEvaluator.Core\AiPromptEvaluator.Core.csproj" />
  </ItemGroup>

</Project>
