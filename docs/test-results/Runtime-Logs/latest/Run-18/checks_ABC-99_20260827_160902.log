osed.","citations":[{"passageId":"P1","source":"Suitability Report Test 1.md","category":"I","quote":"need to outperform your current plan by £4,672 in the first year (in monetary terms)... Based on a mid-growth rate of 2.94%, including our advice fees, the recommended plan would need to grow by 4.8% per year up to age 75","cells":null},{"passageId":"P6","source":"Pension switch report - updated.md","category":"G","quote":null,"cells":["Existing pensions combined","0.3%","0.3%","Reduction in yield"]},{"passageId":"P6","source":"Pension switch report - updated.md","category":"G","quote":null,"cells":["New solution","0.6%","0.6%","Reduction in yield"]},{"passageId":"P7","source":"Pension switch report - updated.md","category":"G","quote":"This results in a shortfall in the death benefit immediately after the switch of £3,305.00","cells":null},{"passageId":"P2","source":"Pension switch report - updated.md","category":"G","quote":null,"cells":["New solution","Aviva Life & Pensions UK Limited","0.6%"]},{"passageId":"P12","source":"Pension switch report - updated.md","category":"G","quote":null,"cells":["Existing pension:","£110,185.60"]},{"passageId":"P12","source":"Pension switch report - updated.md","category":"G","quote":null,"cells":["New solution day one:","£106,880.60"]},{"passageId":"P9","source":"Zurich Policy Info.md","category":"E","quote":"Transfer value and early retirement charge: There are no deductions taken from the current value if benefits are transferred or taken.","cells":null},{"passageId":"P16","source":"Standard_Life_Policy_Info.md","category":"E","quote":null,"cells":["Transfer charge","£0.00"]},{"passageId":"P15","source":"Pension switch report - updated.md","category":"G","quote":"In using this report you acknowledge that nothing in this report is, or shall be deemed to constitute, financial, investment or other advice or a recommendation or endorsement by Defaqto in respect of any product or service referred to herein.","cells":null}],"issueCat