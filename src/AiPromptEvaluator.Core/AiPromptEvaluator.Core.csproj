<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pipeline, with no user interface in it.

    Everything that reads a case, extracts a canonical model, retrieves evidence and assesses a
    check lives here. Nothing in this project references WinForms, so the desktop app is one
    possible front end rather than the only one — a web API, a CLI or a test harness can
    reference this assembly and drive the same pipeline.

    The target framework is still Windows-specific, and deliberately so: DocumentToPdfConverter
    drives Word and Excel over COM to convert a case folder, and that is a Windows dependency
    rather than a WinForms one. Removing it would mean replacing the conversion step, which is a
    larger question than moving files. A front end on Windows is unaffected.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    The canonical model schema and the per-check query plans are data the pipeline reads at run
    time, not source. They are authored under docs/artifacts and copied beside whatever builds
    against this library, so a fresh clone builds and a fresh install works without anyone
    pointing Settings at anything; both locations stay overridable in Settings for anyone
    iterating on them.
  -->
  <ItemGroup>
    <Content Include="..\..\docs\artifacts\canonical-suitability-model.schema.json"
             Link="canonical-suitability-model.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\artifacts\check-plan\*.query-plan.json"
             Link="check-plan\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      Not read at run time. It is the published fact library mapped onto the model, and it is
      copied so the test suite can reconcile the three against each other on every build.
    -->
    <Content Include="..\..\docs\artifacts\fact-library.map.json"
             Link="fact-library.map.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Retrieval ordering, the chat options and the citation matcher are internal detail with no
    place on a public surface, but they are exactly what decides whether two runs of a check
    agree — so the tests need to reach them.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="AiPromptEvaluator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <!-- Pinned to what Microsoft.Extensions.AI already resolves, so the graph has one answer. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.1" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
  </ItemGroup>

</Project>
