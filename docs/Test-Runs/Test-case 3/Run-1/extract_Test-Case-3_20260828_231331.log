  "taxTreatment": {
    "consequencesStated": [
      {
        "text": "Should you die before age 75, the nominated beneficiaries can receive a lump sum, drawdown an income or purchase a dependents annuity. All these options are paid free of tax. Where you die after the age of 75, the same options are available, but tax is paid at the beneficiary\u0027s marginal rate of tax.",
        "topic": "DeathBenefitsTaxation",
        "isClientSpecific": true,
        "provenance": {
          "assertionStatus": "Stated",
          "modality": "Unknown",
          "documentId": "Suitability report 2026.md",
          "documentCategory": "I_RecommendationsAndAdvice",
          "pageNumbers": [
            7
          ],
          "sectionHeading": "Recommended Solution",
          "quote": "Should you die before age 75, the nominated beneficiaries can receive a lump sum, drawdown an income or purchase a dependents annuity. All these options are paid free of tax. Where you die after the age of 75, the same options are available, but tax is paid at the beneficiary\u0027s marginal rate of tax."
        }
      },
      {
        "text": "All payments will be subject to Aviva\u0027s discretion. Where your nominees withdraw from the proceeds it will be tax free should you die before age 75. Where your death occurs on or after age 75 those payments will be subject to the nominee\u0027s marginal rate of tax.",
        "topic": "DeathBenefitsTaxation",
        "isClientSpecific": true,
        "provenance": {
          "assertionStatus": "Stated",
          "modality": "Unknown",
