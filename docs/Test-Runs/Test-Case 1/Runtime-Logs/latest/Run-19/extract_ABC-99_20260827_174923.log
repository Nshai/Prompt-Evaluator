      "netBenefitConclusion": [
        {
          "text": "Aviva platform is 0.24% less expensive than current plans (like-for-like), meaning the proposed plan can underperform the current plan by £264 in the first year",
          "topic": "LikeLikeCostComparison",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Actual",
            "documentId": "Suitability Report Test 1.pdf",
            "documentCategory": "I_RecommendationsAndAdvice",
            "pageNumbers": [11],
            "quote": "Based on information supplied by your existing providers, our calculations show that the Aviva plan is 0.24% less expensive than your current plans. This means that your proposed plan can underperform your current plan by £264 in the first year (in monetary terms)."
          }
        },
        {
          "text": "Including adviser fees, Aviva plan is 4.24% more expensive than current plans, meaning proposed plan will need to outperform current plan by £4,672 in the first year",
          "topic": "IncludingAdviserFeeComparison",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Actual",
            "documentId": "Suitability Report Test 1.pdf",
            "documentCategory": "I_RecommendationsAndAdvice",
            "pageNumbers": [11],
            "quote": "As we have agreed to be remunerated via the policy (initial and ongoing), our calculations showed that the Aviva plan is 4.24% more expensive than your current plans. This means that your proposed plan will need to outperform your current plan by £4,672 in the first year (in monetary terms)."
          }
        },
        {
          "text": "Based on mid-growth rate of 2.94% and including advice fees, recommended plan would need to grow by 4.8% per year up to age 75 to meet the same value as current plan; based on past performance of recommended funds, this is achievable",
          "topic": "CriticalYieldAssessment",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Assumed",
            "documentId": "Suitability Report Test 1.pdf",
            "documentCategory": "I_RecommendationsAndAdvice",
            "pageNumbers": [11],
            "quote": "Based on a mid-growth rate of 2.94%, including our advice fees, the recommended plan would need to grow by 4.8% per year up to age 75 in order to meet the same value as your current plan. Based on the past performance of your recommended funds, I do believe that this is achievable."
          }
        },
        {
          "text": "Your Zurich investments are allocated to higher-risk funds more susceptible to volatility, whereas Aviva platform funds selected align with agreed risk tolerance and deliver comparable performance with reduced volatility",
          "topic": "RiskVolatilityTrade",
          "isClientSpecific": true,
          "provenance": {
            "assertionStatus": "Stated",
            "modality": "Actual",
            "documentId": "Suitability Report Test 1.pdf",
            "documentCategory": "I_RecommendationsAndAdvice",
            "pageNumbers": [13],
            "quote": "It's important to note that your Zurich investments are allocated to higher-risk funds, which are more susceptible to market volatility, resulting in greater fluctuations in value. In contrast, the Aviva platform funds selected for you align with your agreed risk tolerance and have delivered comparable performance with reduced volatility."
          }
        }
