          "method": "SetCoverage",
          "tolerance": "Each dimension the report compares must be supported by provider or research documentation.",
          "falsePositiveGuards": [
            "Provider fund-range and option data changes over time; check the date of the research before treating a difference as an error.",
            "Where the existing scheme is better on a dimension, the report must say so — a one-sided comparison is a finding in itself."
          ]
        },
        "sufficiency": {
          "ifAssertionAbsent": "Potential Concern: a switch recommended with no comparison of what is being left behind.",
          "ifEvidenceAbsent": "Potential Concern: comparison asserted with no switch analysis or provider data on file.",
          "minEvidenceCategories": 1
        }
      }
