            "documentCategory": "I_RecommendationsAndAdvice"
          }
        },
        {
          "text": "Enhanced Retirement Flexibility - The receiving scheme provides more flexible retirement options, ensuring you can access your pension savings in a way that best suits your needs, including tax-efficient withdrawal strategies.",
          "topic": "EnhancedRetirementFlexibility",
          "isClientSpecific": true,
          "linkedObjectiveIds": [
