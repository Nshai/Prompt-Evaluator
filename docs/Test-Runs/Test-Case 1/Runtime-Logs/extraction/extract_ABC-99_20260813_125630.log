    "valueAssessment": {
      "benefitsStated": [
        {
          "text": "Lower Costs - The receiving scheme has a lower overall cost structure compared to your existing pension, meaning more of your savings remain invested for growth rather than being lost to charges.",
          "topic": "LowerCosts",
          "isClientSpecific": true,
          "linkedObjectiveIds": ["RetireWithClearer Understanding"],
          "provenance": {
            "assertionStatus": "Stated",
