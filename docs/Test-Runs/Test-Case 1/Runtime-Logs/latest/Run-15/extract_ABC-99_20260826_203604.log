      "type": "object",
      "description": "Attach to every extracted entity or statement. This is what makes the model auditable: a QA finding must be able to cite where in the document the asserted fact came from.",
      "additionalProperties": false,
      "required": [
        "assertionStatus"
      ],
      "properties": {
        "assertionStatus": {
          "description": "Stated = explicit in the document. Inferred = the LLM concluded it from narrative prose. Derived = calculated from other extracted values. Absent = the model expected it and could not find it. One of: Stated, Inferred, Derived, Absent.",
          "type": "string"
        },
        "documentId": {
          "type": "string",
          "description": "Identifier of the source document within the case bundle."
        },
        "documentCategory": {
          "$ref": "#/$defs/DocumentCategory"
        },
        "pageNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sectionHeading": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim supporting text, trimmed. Required whenever assertionStatus is Stated or Inferred."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extractionNote": {
          "type": "string",
          "description": "Why the LLM read the text this way; ambiguity flags."
        }
      }
    },
    "Money": {
      "type": "object",
      "description": "Aligned to Intelliflo Office CurrencyValue.",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "default": "GBP"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "description": "One of: Gross, Net, Unspecified."
        },
        "asAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Percentage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Percentage points, e.g. 0.44 means 0.44%."
        },
        "basis": {
          "type": "string",
          "description": "What the percentage is of, e.g. \u0027of fund value pa\u0027."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Frequency": {
      "description": "Intelliflo Office frequency enum plus OneOff/Unspecified. One of: Monthly, Weekly, Fortnightly, FourWeekly, Quarterly, HalfYearly, Annually, OneOff, Unspecified.",
      "type": "string"
    },
    "DocumentCategory": {
      "description": "Quality-check document taxonomy (Document Categories v1). One of: A_ClientAuthority, B_KnowYourClient, C_MeetingsAndCommunications, D_RiskCapacityAndExperience, E_ExistingPlansAndPortfolios, F_NeedsAnalysis, G_Research, H_SolutionDesign, I_RecommendationsAndAdvice.",
      "type": "string"
    },
    "Statement": {
      "type": "object",
      "description": "A narrative assertion the report makes that a check must test for presence, specificity and consistency (rationale bullets, risk warnings, disadvantages, explanations).",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "topic": {
          "type": "string",
