<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    The canonical model schema and the per-check query plans are data the app reads at run
    time, not source. They are authored under docs/artifacts and copied beside the executable
    so a fresh clone builds and a fresh install works without the user pointing Settings at
    anything; both locations stay overridable in Settings for anyone iterating on them.
  -->
  <ItemGroup>
    <Content Include="..\..\docs\artifacts\canonical-suitability-model.schema.json"
             Link="canonical-suitability-model.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\artifacts\check-plan\*.query-plan.json"
             Link="check-plan\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Retrieval ordering and the chat options are internal detail with no place on a public
    surface, but they are exactly what decides whether two runs of a check agree — so the
    tests need to reach them.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="AiPromptEvaluator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.1" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
  </ItemGroup>
</Project>
